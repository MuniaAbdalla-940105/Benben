# Browser env (ADR-002 §15). Only VITE_* variables reach the bundle; never put a service-role or secret key here.
# Locally, `pnpm db:start` writes .env.local with the right values (tools/dev/write-local-env.sh).
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=<publishable (anon) key from `pnpm exec supabase status`>
VITE_APP_ENV=local
# VITE_MOCK_GATEWAY_URL=   # non-prod only, from ST-007
